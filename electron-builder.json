{
  "appId": "dev.attlas.papelaria-opcao",
  "productName": "Papelaria Opção",
  "directories": {
    "output": "release"
  },
  "files": [
    "dist/**/*",
    "dist-electron/**/*",
    "recursos/icone/icone.png"
  ],
  "linux": {
    "target": [
      "AppImage",
      "deb"
    ],
    "category": "Office",
    "synopsis": "Aplicacao de mesa com banco online",
    "syncDesktopName": true,
    "maintainer": "Attlas",
    "icon": "recursos/icone/icone.png"
  },
  "win": {
    "target": "nsis",
    "icon": "recursos/icone/icone.png"
  },
  "nsis": {
    "oneClick": false,
    "perMachine": false,
    "allowToChangeInstallationDirectory": true,
    "shortcutName": "Papelaria Opção"
  },
  "executableName": "papelaria-opcao",
  "artifactName": "papelaria-opcao-${version}-${os}-${arch}.${ext}"
}
